<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Probe only (Phase 0 diagnostics). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Cleartext HTTP to the LAN companion (only after its HMAC proof checks out). -->
    <application
        android:name=".OrbitApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Orbit"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit">

        <!-- Phase 1: the app icon opens the diary recorder. -->
        <activity-alias
            android:name=".Launcher"
            android:exported="true"
            android:targetActivity="com.orbit.voice.RecorderActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Diagnostics: adb shell am start -n com.orbit/.probe.ProbeActivity -->
        <activity
            android:name=".probe.ProbeActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <service
            android:name=".probe.ProbeRecordService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:process=":voice" />
    </application>
</manifest>
